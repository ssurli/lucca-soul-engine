# =============================================================================
#  LUCCA SOUL LAB — configurazione (MODALITÀ CLOUD)
#  Copia questo file in .env e compila i campi vuoti.
#  .env è già in .gitignore: NON committarlo, NON incollarne il contenuto in chat.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) NEO4J AURA  — Urban Knowledge Graph
#    Console: https://console.neo4j.io -> Instances
#    ATTENZIONE: lo schema è  neo4j+s://  (TLS).  bolt:// NON funziona con Aura.
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://0d40c843.databases.neo4j.io
NEO4J_USERNAME=neo4j
# Password: dal file credenziali scaricato alla creazione dell'istanza.
# Persa? Aura non la mostra più: va resettata dalla console.
NEO4J_PASSWORD=""
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=0d40c843
AURA_INSTANCENAME="My instance"

# -----------------------------------------------------------------------------
# 2) NEON  — PostgreSQL (transazionale, eventi, Urban Memory)
#    Console: https://console.neon.tech -> progetto -> pulsante "Connect"
#    Scegli Branch / Compute / Database / Role e copia l'URL.
#
#    Forma dell'URL:
#    postgresql://ROLE:PASSWORD@ENDPOINT-ID[-pooler].REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
#
#    ⚠  sslmode=require è OBBLIGATORIO: senza, Neon rifiuta la connessione.
#    ⚠  Password persa? Non è recuperabile. Connect -> selettore del ruolo ->
#       "Reset password" (oppure Branches -> Roles & Databases -> menu ruolo).
#       Neon la mostra UNA SOLA VOLTA: copiala subito qui sotto.
# -----------------------------------------------------------------------------

# DIRETTA (senza -pooler nell'host): usala per MIGRAZIONI, seed, pg_dump.
# Nel Connect di Neon: disattiva il toggle "Connection pooling" per ottenerla.
DATABASE_URL="postgresql://ROLE:PASSWORD@ep-xxxxxxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require"

# POOLED (host con suffisso -pooler): per client serverless / alta concorrenza.
# Opzionale nell'MVP. Lasciala vuota se non ti serve.
DATABASE_URL_POOLED=""

# -----------------------------------------------------------------------------
# 3) QDRANT  — Vector DB per la RAG (gira in locale via Docker)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# -----------------------------------------------------------------------------
# 4) ANTHROPIC  — assistente conversazionale e generazione dei `reason`
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
