# =============================================================================
#  LUCCA SOUL LAB — configurazione (MODALITÀ CLOUD, ZERO INFRASTRUTTURA LOCALE)
#  Copia questo file in .env e compila i campi vuoti.
#  I valori vanno tra virgolette: password e URL contengono spesso caratteri
#  (spazi, &, ?) che altrimenti la shell interpreta.
#  .env è già in .gitignore: NON committarlo, NON incollarne il contenuto in chat.
#
#  Niente Docker, niente servizi locali: tutto gira su Aura + Neon.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) NEO4J AURA  — Urban Knowledge Graph
#    Console: https://console.neo4j.io -> Instances
#    ATTENZIONE: lo schema è  neo4j+s://  (TLS).  bolt:// NON funziona con Aura.
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
# Password: dal file credenziali scaricato alla creazione dell'istanza.
# Persa? Aura non la mostra più: va resettata dalla console.
NEO4J_PASSWORD=""
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME="My instance"

# -----------------------------------------------------------------------------
# 2) NEON  — PostgreSQL: transazionale + eventi + Urban Memory + VECTOR STORE
#    Console: https://console.neon.tech -> progetto -> pulsante "Connect"
#
#    ⚠  sslmode=require è OBBLIGATORIO.
#    ⚠  Usa la stringa DIRETTA (senza -pooler): serve per migrazioni e seed.
#       Nel Connect di Neon: disattiva il toggle "Connection pooling".
#    ⚠  Password persa? Non è recuperabile: Connect -> selettore ruolo ->
#       "Reset password". Neon la mostra UNA SOLA VOLTA.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://ROLE:PASSWORD@ep-xxxxxxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require"

# Opzionale: stringa pooled (host con suffisso -pooler) per alta concorrenza.
DATABASE_URL_POOLED=""

# -----------------------------------------------------------------------------
# 3) VECTOR STORE  — pgvector DENTRO Neon (nessun Qdrant, nessun Docker)
#    Abilitazione, una volta sola, dal SQL Editor di Neon:
#        CREATE EXTENSION IF NOT EXISTS vector;
#    Verifica:
#        SELECT extname, extversion FROM pg_extension WHERE extname = 'vector';
#    (L'estensione si chiama "vector", non "pgvector".)
# -----------------------------------------------------------------------------
VECTOR_BACKEND=pgvector
# Dimensione degli embedding: allineala al modello che usi.
EMBEDDING_DIM=1536

# -----------------------------------------------------------------------------
# 4) ANTHROPIC  — assistente conversazionale e generazione dei `reason`
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
