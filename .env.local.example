# =============================================================================
#  LUCCA SOUL LAB — PROFILO LOCALE (macchina con Docker)
#  Copia in .env sul PC fisso, dopo aver fatto `docker compose up -d`.
#
#  Stesso codice del profilo cloud: cambia SOLO questo file.
#  Vector store: pgvector, come su Neon. Una sola implementazione RAG.
# =============================================================================

# --- Neo4j Community (Docker locale) ---
# In LOCALE lo schema è bolt:// (nessun TLS). Con Aura sarebbe neo4j+s://
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD="luccasoul"
NEO4J_DATABASE=neo4j

# --- Postgres locale (immagine pgvector/pgvector) ---
POSTGRES_USER=lucca
POSTGRES_PASSWORD=lucca
POSTGRES_DB=lucca_soul
DATABASE_URL="postgresql://lucca:lucca@localhost:5432/lucca_soul"
DATABASE_URL_POOLED=""

# --- Vector store: pgvector, dentro lo stesso Postgres ---
VECTOR_BACKEND=pgvector
EMBEDDING_DIM=1536

# --- Anthropic ---
ANTHROPIC_API_KEY=""
